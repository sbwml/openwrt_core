Package: kmod-keys-encrypted
Version: 6.12.34-r1
Depends: kernel (=6.12.34~948acc62564d256c16e6ec16880d002c-r1), kmod-crypto-cbc, kmod-crypto-hmac, kmod-crypto-rng, kmod-crypto-sha256, kmod-keys-trusted
Source: feeds/base/kernel/linux
SourceName: kernel
